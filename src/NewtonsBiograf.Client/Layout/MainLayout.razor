@using System.Security.Claims
@inherits LayoutComponentBase
@inject JwtAuthStateProvider AuthState
@inject NavigationManager Nav

<div class="shell">
    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" href="/" aria-label="Newtons Biograf, home">Newtons <span>Biograf</span></a>
            <button type="button" class="nav-toggle" aria-expanded="@navOpen.ToString().ToLowerInvariant()"
                    aria-controls="main-nav" @onclick="ToggleNav">
                @(navOpen ? "Close" : "Menu")
            </button>
            <nav id="main-nav" class="main-nav @(navOpen ? "open" : "")" aria-label="Main">
                <ul>
                    <li><NavLink href="" Match="NavLinkMatch.All" @onclick="CloseNav">Home</NavLink></li>
                    <AuthorizeView Roles="@Roles.Admin">
                        <li><NavLink href="admin/staff" @onclick="CloseNav">Staff</NavLink></li>
                    </AuthorizeView>
                    <AuthorizeView>
                        <NotAuthorized>
                            <li><NavLink href="login" @onclick="CloseNav">Log in</NavLink></li>
                            <li><NavLink href="register" @onclick="CloseNav">Register</NavLink></li>
                        </NotAuthorized>
                    </AuthorizeView>
                </ul>
            </nav>
            <div class="auth-slot">
                <AuthorizeView>
                    <Authorized>
                        <div class="auth-info">
                            <span>@context.User.Identity?.Name (@context.User.FindFirst(ClaimTypes.Role)?.Value)</span>
                            <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="LogoutAsync">Log out</AppButton>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <main class="container">
        @Body
    </main>

    <footer class="site-footer">
        <div class="container">&copy; Newtons Biograf</div>
    </footer>
</div>

@code {
    private bool navOpen;

    private void ToggleNav() => navOpen = !navOpen;

    private void CloseNav() => navOpen = false;

    private async Task LogoutAsync()
    {
        await AuthState.Logout();
        Nav.NavigateTo("/");
    }
}
