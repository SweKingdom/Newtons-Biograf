@page "/"
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Newtons Biograf</PageTitle>

<h1>Now showing at Newtons Biograf</h1>
<p class="text-muted">Movies, showings and seat booking are coming soon.</p>

<Card Title="System status">
    @if (status is null)
    {
        <Spinner />
    }
    else
    {
        <p>API status: @status</p>
    }
</Card>

@code {
    private string? status;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            var health = await client.GetFromJsonAsync<HealthResponse>("api/health");
            status = health?.Status ?? "unknown";
        }
        catch (HttpRequestException)
        {
            status = "unreachable";
        }
    }
}
